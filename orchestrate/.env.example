# Copy this file to orchestrate/.env and fill in your values.
# NEVER commit orchestrate/.env to source control — it contains secrets.
#
# These values are read by orchestrate/fraud_detection_toolkit/fraud_actions.py.
# After running `terraform apply`, all values are printed by `terraform output`.

# Path to the Confluent CLI binary (brew install confluentinc/tap/cli)
CONFLUENT_CLI_PATH=/opt/homebrew/bin/confluent

# Confluent Cloud cluster & environment IDs (from `terraform output`)
KAFKA_CLUSTER_ID=lkc-xxxxxxx
KAFKA_ENVIRONMENT=env-xxxxxxx

# Kafka API key scoped to the cluster (from `terraform output`)
KAFKA_API_KEY=YOUR_KAFKA_API_KEY
KAFKA_API_SECRET=YOUR_KAFKA_API_SECRET

# Kafka bootstrap endpoint (from `terraform output`)
KAFKA_BOOTSTRAP_SERVERS=SASL_SSL://pkc-xxxx.us-east-1.aws.confluent.cloud:9092
